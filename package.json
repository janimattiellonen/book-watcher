{
  "name": "book-watcher",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "PORT=3192 react-router-serve ./build/server/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run format",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/migrate.ts up",
    "db:migrate:down": "tsx --env-file-if-exists=.env src/scripts/migrate.ts down",
    "db:migrate:create": "node-pg-migrate create -m migrations -j sql",
    "test:db": "POSTGRES_DB=book_watcher_test tsx --env-file-if-exists=.env src/scripts/migrate.ts up && POSTGRES_DB=book_watcher_test vitest run --config vitest.db.config.ts --passWithNoTests",
    "capture": "tsx --env-file-if-exists=.env src/scripts/capture.ts",
    "search": "tsx --env-file-if-exists=.env src/scripts/search.ts",
    "run-listener": "tsx --env-file-if-exists=.env src/scripts/runListener.ts",
    "digest": "tsx --env-file-if-exists=.env src/scripts/digest.ts",
    "test-email": "tsx --env-file-if-exists=.env src/scripts/testEmail.ts"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "cheerio": "^1.2.0",
    "isbot": "^5.2.2",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "resend": "^6.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
