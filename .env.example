# Book Watcher configuration. Copy to .env and adjust; every key has a default.
# Keys are added here as each part of the system is built (see plans/).

# --- Database (Docker Postgres, see docker-compose.yml) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5499
POSTGRES_USER=book_watcher
POSTGRES_PASSWORD=book_watcher
POSTGRES_DB=book_watcher

# --- Scheduler rate limits ---
# Hours between two runs of the same listener (minimum 24).
LISTENER_INTERVAL_HOURS=24
# Minutes between the end of one listener run and the start of the next, plus 0..jitter.
MIN_GAP_MINUTES=30
GAP_JITTER_MINUTES=10

# --- Scraping ---
MAX_PAGES_PER_SEARCH=10
# Price of one Swedish krona in euros (Bokus prices are in SEK).
SEK_TO_EUR=0.087
